# Analytiikka ja markkinointi. Skriptit ladataan vain jos kavija on antanut
# suostumuksen evastebannerissa. Jos tunnus puuttuu, kyseista skriptia ei
# ladata lainkaan.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Lomakkeet ja kartoitusvaraus (palvelimen muuttujat, ei NEXT_PUBLIC).
# Resend lahettaa lomakeviestit ja vahvistukset, ks. app/api/posti.ts.
RESEND_API_KEY=
# Googlen palvelutili varauskalenteria varten, ks. app/api/varaus/google.ts.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_SA_SUBJECT=info@wsmedia.fi

# Google Ads -konversiot (ks. app/components/consent/seuranta.ts). Arvot
# ovat Google Adsin konversiotoimintojen tapahtumakoodin send_to-merkkijonot
# (AW-.../...). Ads ei ole GA4-tagin kohde: koodi tekee suostumuksen jalkeen
# gtag('config', 'AW-...') kerran kullekin AW-tunnukselle samaan gtag.js:aan
# (ei toista skriptia). Tyhja tai virheellinen arvo ohitetaan.
# NEXT_PUBLIC_-muuttujat luetaan kaannoksessa: muutos vaatii uuden julkaisun.
NEXT_PUBLIC_GADS_SEND_TO_LOMAKE=
NEXT_PUBLIC_GADS_SEND_TO_VARAUS=
NEXT_PUBLIC_GADS_SEND_TO_PUHELU=
