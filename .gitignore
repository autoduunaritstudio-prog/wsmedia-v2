# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example on malli ilman arvoja, se kuuluu versionhallintaan
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raakavideot projektin juuressa (lahdemateriaali, ei versionhallintaan).
# Ankkuroitu juureen, joten public/-kansion pakatut videot eivat osu tahan.
/*.mov
/*.MOV
/*.mp4

# Projektin juureen pudotetut raakatiedostot (kuvat, videot). Ne ovat
# tyoskentelymateriaalia eivatka kuulu repoon; public/ pysyy normaalina.
/*.jpg
/*.jpeg
/*.png
/*.zip
/*.mov
/*.mp4
